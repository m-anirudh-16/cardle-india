{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/*.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/|assets/|manifest\\.webmanifest|sw\\.js|workbox-.*\\.js|favicon\\.ico|icon\\.svg|apple-touch-icon\\.png|pwa-.*\\.png).*)",
      "destination": "/index.html"
    }
  ]
}
